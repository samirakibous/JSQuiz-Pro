<%- include('partials/header') %>
<body class="bg-gradient-to-br from-blue-50 to-indigo-100 min-h-screen">
    <%- include('partials/navbar') %>

    <div class="container mx-auto px-4 py-8">
        <!-- En-tête -->
        <div class="text-center mb-10">
            <h1 class="text-5xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-indigo-600 mb-3">
                JSQuiz-Pro
            </h1>
            <p class="text-gray-600 text-lg">Testez vos connaissances en développement web</p>
        </div>

        <% if (user && userStats) { %>
        <!-- Layout en 3 colonnes -->
        <div class="grid lg:grid-cols-12 gap-6 mb-10">

            <!-- COLONNE GAUCHE: Informations utilisateur -->
            <div class="lg:col-span-3">
                <div class="bg-white rounded-xl shadow-lg p-6 sticky top-4">
                    <div class="text-center mb-6">
                        <div class="w-20 h-20 bg-gradient-to-br from-blue-500 to-indigo-600 rounded-full mx-auto mb-4 flex items-center justify-center">
                            <i class="fas fa-user text-3xl text-white"></i>
                        </div>
                        <h3 class="text-2xl font-bold text-gray-800"><%= userStats.username %></h3>
                    </div>

                    <div class="border-t border-gray-200 pt-4 space-y-4">
                        <div class="bg-gradient-to-r from-blue-50 to-indigo-50 rounded-lg p-4">
                            <p class="text-sm text-gray-600 mb-1">Points moyens</p>
                            <p class="text-3xl font-bold text-blue-600"><%= userStats.average %></p>
                        </div>

                        <div class="bg-gray-50 rounded-lg p-4">
                            <p class="text-sm text-gray-600 mb-1">
                                <i class="fas fa-trophy text-yellow-500 mr-2"></i>Niveau
                            </p>
                            <p class="text-lg font-semibold text-gray-800">
                                <% if (userStats.average >= 9) { %>
                                    Expert 🔥
                                <% } else if (userStats.average >= 8) { %>
                                    Avancé ⭐
                                <% } else if (userStats.average >= 5) { %>
                                    Intermédiaire 📚
                                <% } else { %>
                                    Débutant 🌱
                                <% } %>
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- COLONNE CENTRALE: Quiz (Thématiques) -->
            <div class="lg:col-span-6">
                <div class="bg-white rounded-xl shadow-lg p-8">
                    <h2 class="text-3xl font-bold mb-8 text-center text-gray-800">
                        <i class="fas fa-gamepad text-blue-500 mr-3"></i>Choisissez votre défi
                    </h2>

                    <div class="grid md:grid-cols-2 gap-6">
                        <% thematiques.forEach(theme => { %>
                        <div class="group bg-gradient-to-br from-blue-50 to-indigo-50 rounded-xl p-6 border-2 border-transparent hover:border-blue-400 hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
                            <div class="text-center">
                                <div class="w-16 h-16 bg-gradient-to-br from-blue-500 to-indigo-600 rounded-full mx-auto mb-4 flex items-center justify-center group-hover:scale-110 transition-transform">
                                    <i class="fas fa-code text-2xl text-white"></i>
                                </div>

                                <h3 class="text-xl font-bold mb-3 text-gray-800"><%= theme.thematique %></h3>
                                <p class="text-gray-600 mb-5 text-sm">Testez vos compétences</p>

                                <a href="/quiz/<%= theme.thematique %>"
                                   class="inline-block bg-gradient-to-r from-blue-500 to-indigo-600 text-white px-6 py-3 rounded-lg font-semibold hover:from-blue-600 hover:to-indigo-700 transition-all duration-300 shadow-md hover:shadow-lg">
                                    <i class="fas fa-play mr-2"></i>Commencer
                                </a>
                            </div>
                        </div>
                        <% }) %>
                    </div>
                </div>
            </div>

            <!-- COLONNE DROITE: Dernier score + Top 5 -->
            <div class="lg:col-span-3 space-y-6">

                <!-- Dernier score -->
                <div class="bg-white rounded-xl shadow-lg p-6 top-4">
                    <h3 class="text-xl font-bold mb-4 text-gray-800 flex items-center">
                        <i class="fas fa-clock text-blue-500 mr-2"></i>Dernier score
                    </h3>

                    <% if (lastScore) { %>
                        <div class="bg-gradient-to-br from-green-50 to-emerald-50 rounded-lg p-4 border-l-4 border-green-500">
                            <div class="mb-3">
                                <p class="text-xs text-gray-600 mb-1">Thématique</p>
                                <p class="font-semibold text-gray-800"><%= lastScore.thematique %></p>
                            </div>

                            <div class="mb-3">
                                <p class="text-xs text-gray-600 mb-1">Score</p>
                                <p class="text-3xl font-bold text-green-600"><%= lastScore.score %></p>
                            </div>

                            <div>
                                <p class="text-xs text-gray-500">
                                    <i class="far fa-calendar mr-1"></i>
                                    <%= new Date(lastScore.date_played).toLocaleDateString('fr-FR') %>
                                </p>
                            </div>
                        </div>
                    <% } else { %>
                        <div class="text-center py-8 text-gray-400">
                            <i class="fas fa-inbox text-4xl mb-3"></i>
                            <p>Aucun score enregistré</p>
                        </div>
                    <% } %>
                </div>

                <!-- Top 5 utilisateurs -->
                <div class="bg-white rounded-xl shadow-lg p-6">
                    <h3 class="text-xl font-bold mb-4 text-gray-800 flex items-center">
                        <i class="fas fa-trophy text-yellow-500 mr-2"></i>Top 5
                    </h3>

                    <% if (topUsers && topUsers.length > 0) { %>
                        <div class="space-y-3">
                            <% topUsers.forEach((topUser, index) => { %>
                                <div class="flex items-center justify-between p-3 rounded-lg <%= index === 0 ? 'bg-gradient-to-r from-yellow-50 to-amber-50 border border-yellow-200' : index === 1 ? 'bg-gradient-to-r from-gray-50 to-slate-50 border border-gray-200' : index === 2 ? 'bg-gradient-to-r from-orange-50 to-amber-50 border border-orange-200' : 'bg-gray-50' %>">
                                    <div class="flex items-center space-x-3">
                                        <div class="w-8 h-8 rounded-full flex items-center justify-center font-bold <%= index === 0 ? 'bg-yellow-400 text-white' : index === 1 ? 'bg-gray-400 text-white' : index === 2 ? 'bg-orange-400 text-white' : 'bg-blue-100 text-blue-600' %>">
                                            <%= index + 1 %>
                                        </div>
                                        <span class="font-semibold text-gray-800"><%= topUser.username %></span>
                                    </div>
                                    <span class="text-lg font-bold text-blue-600">
                                        <%= Math.round(topUser.average * 100) / 100 %>
                                    </span>
                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <div class="text-center py-8 text-gray-400">
                            <i class="fas fa-users text-4xl mb-3"></i>
                            <p>Aucun classement disponible</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>

        <% } else { %>
        <!-- Version non connectée -->
        <div class="max-w-4xl mx-auto">
            <div class="bg-white rounded-xl shadow-lg p-8 mb-8 text-center">
                <i class="fas fa-lock text-5xl text-gray-400 mb-4"></i>
                <h2 class="text-2xl font-bold mb-4 text-gray-800">Connectez-vous pour jouer</h2>
                <p class="text-gray-600 mb-6">Créez un compte pour accéder aux quiz et suivre vos progrès</p>
                <a href="/login" class="inline-block bg-gradient-to-r from-blue-500 to-indigo-600 text-white px-8 py-3 rounded-lg font-semibold hover:from-blue-600 hover:to-indigo-700 transition-all duration-300 shadow-md hover:shadow-lg">
                    <i class="fas fa-sign-in-alt mr-2"></i>Se connecter
                </a>
            </div>

            <h2 class="text-2xl font-semibold mb-6 text-center text-gray-800">Thématiques disponibles</h2>

            <div class="grid md:grid-cols-3 gap-6">
                <% thematiques.forEach(theme => { %>
                <div class="bg-white rounded-lg shadow-md p-6 opacity-75">
                    <div class="text-center">
                        <i class="fas fa-code text-4xl text-gray-400 mb-4"></i>
                        <h3 class="text-xl font-semibold mb-3 text-gray-800"><%= theme.thematique %></h3>
                        <p class="text-gray-600 mb-4">Quiz sur <%= theme.thematique %></p>
                        <button disabled class="bg-gray-300 text-gray-600 px-6 py-2 rounded cursor-not-allowed">
                            <i class="fas fa-lock mr-2"></i>Verrouillé
                        </button>
                    </div>
                </div>
                <% }) %>
            </div>
        </div>
        <% } %>
    </div>

    <%- include('partials/footer') %>
</body>
</html>